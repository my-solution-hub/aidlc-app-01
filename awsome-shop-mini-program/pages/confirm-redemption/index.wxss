.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.header {
  padding: 16rpx 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.confirm-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.product-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.product-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.product-thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  font-size: 64rpx;
  opacity: 0.6;
}

.product-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: 600;
}

.divider {
  height: 2rpx;
  background: var(--border-soft);
  width: 100%;
}

.summary {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}

.summary-value {
  font-weight: 600;
  color: var(--text-primary);
}

.cost-value {
  color: var(--warning);
}

.remaining-value {
  font-size: 36rpx;
  font-weight: 700;
}

.remaining-good {
  color: var(--success);
}

.remaining-bad {
  color: var(--danger);
}

.alert-error {
  background: var(--danger-soft);
  color: var(--danger);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions .btn-outline {
  flex: 1;
}

.actions .btn-primary {
  flex: 1.5;
}

.btn-disabled {
  background: #CBD5E1 !important;
}

.spinner-light {
  border-color: rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  width: 36rpx;
  height: 36rpx;
}

.small {
  font-size: 22rpx;
}

.address-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.address-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-add {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

.address-empty {
  background: var(--bg-page);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.address-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.address-card {
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.address-card-active {
  border-color: var(--primary);
  background: var(--primary-soft);
}

.address-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.default-tag {
  background: #DBEAFE;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.address-detail {
  font-size: 24rpx;
}

.address-form {
  margin-top: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.address-input {
  height: 72rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.address-form-actions {
  display: flex;
  gap: 16rpx;
}

.address-form-actions .btn-outline {
  flex: 1;
}

.address-form-actions .btn-primary {
  flex: 1;
}
