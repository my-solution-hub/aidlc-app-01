.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 96rpx;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  padding: 0 20rpx;
  height: 80rpx;
}

.search-icon {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.placeholder {
  color: var(--text-disabled);
}

.tab-scroll {
  white-space: nowrap;
}

.tab-list {
  display: flex;
  gap: 12rpx;
  padding: 4rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  display: flex;
  flex-direction: column;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid var(--border-soft);
}

.record-no {
  font-size: 24rpx;
}

.status-chip {
  border-radius: 16rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.record-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.record-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.record-thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  font-size: 44rpx;
  color: var(--primary);
}

.record-info {
  flex: 1;
  min-width: 0;
}

.record-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-desc {
  font-size: 24rpx;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-points {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  flex-shrink: 0;
}

.record-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-top: 2rpx solid var(--border-soft);
  font-size: 22rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

.record-action {
  color: var(--primary);
  font-weight: 600;
}

.record-foot-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-left: auto;
}

.confirm-btn {
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
}

.btn-disabled {
  background: #CBD5E1;
}

.spinner-light {
  border-color: rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  width: 24rpx;
  height: 24rpx;
}

.search-btn {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 0 12rpx;
}

.end-hint {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}
