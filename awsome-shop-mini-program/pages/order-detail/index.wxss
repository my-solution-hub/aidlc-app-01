.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 96rpx;
}

.hero-card {
  border-radius: 24rpx;
  padding: 36rpx;
  color: #fff;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.hero-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.hero-icon {
  font-size: 40rpx;
}

.hero-status {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-line {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-action {
  background: #fff;
  color: var(--primary);
  font-weight: 700;
  border-radius: 16rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-action.btn-disabled {
  opacity: 0.6;
}

.section-card {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.divider {
  width: 100%;
  height: 2rpx;
  background: var(--border-soft);
}

.cancelled-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FEF2F2;
  color: #991B1B;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.cancelled-icon {
  font-size: 32rpx;
  color: #DC2626;
}

/* Horizontal stepper */
.stepper {
  display: flex;
  align-items: flex-start;
  padding-top: 8rpx;
}

.stepper-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  gap: 8rpx;
}

.stepper-connector {
  position: absolute;
  top: 36rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  z-index: 0;
}

.stepper-circle {
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: #fff;
}

.stepper-label {
  font-size: 24rpx;
  text-align: center;
}

.stepper-time {
  font-size: 20rpx;
  color: var(--text-disabled);
  text-align: center;
  min-height: 28rpx;
}

/* Product row */
.product-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.product-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.product-thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  font-size: 56rpx;
  color: var(--primary);
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.product-name {
  font-size: 30rpx;
  font-weight: 600;
}

.product-desc {
  font-size: 24rpx;
}

.product-points {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--warning);
}

/* Info rows */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  gap: 16rpx;
}

.addr-value {
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.balance-after {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--success);
}

/* Status log */
.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-row {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
  min-height: 100rpx;
}

.timeline-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #16A34A;
  margin-top: 8rpx;
}

.timeline-dot-current {
  background: #2563EB;
}

.timeline-line {
  flex: 1;
  width: 4rpx;
  background: var(--border);
  margin-top: 4rpx;
}

.timeline-body {
  padding: 4rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.timeline-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.small {
  font-size: 22rpx;
}

.footer {
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.footer .btn-outline,
.footer .btn-primary {
  width: 100%;
}

.btn-disabled {
  background: #CBD5E1;
}

.spinner-light {
  border-color: rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  width: 36rpx;
  height: 36rpx;
}
