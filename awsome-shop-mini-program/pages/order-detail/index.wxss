.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 96rpx;
}

.header {
  padding: 28rpx;
}

.head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.small {
  font-size: 24rpx;
  margin-top: 4rpx;
}

.status-chip {
  border-radius: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.section-card {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.divider {
  width: 100%;
  height: 2rpx;
  background: var(--border-soft);
}

.cancelled-text {
  font-size: 26rpx;
  color: #991B1B;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timeline-row {
  display: flex;
  gap: 20rpx;
  align-items: stretch;
  min-height: 80rpx;
}

.timeline-marker {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  margin-top: 8rpx;
}

.timeline-line {
  flex: 1;
  width: 4rpx;
  margin-top: 4rpx;
}

.timeline-label {
  padding: 4rpx 0 24rpx;
  font-size: 28rpx;
}

.product-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.product-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.product-thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-placeholder {
  font-size: 48rpx;
  color: var(--primary);
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
}

.product-points {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--warning);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
}

.footer {
  padding: 24rpx 0;
}

.footer .btn-outline {
  width: 100%;
}
