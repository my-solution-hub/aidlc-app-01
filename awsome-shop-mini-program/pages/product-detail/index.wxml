<view class="page">
  <view wx:if="{{loading}}" class="empty">
    <view class="spinner"></view>
  </view>

  <block wx:elif="{{product}}">
    <view class="product-image" style="background:{{categoryBg}}">
      <image
        wx:if="{{activeImageSrc}}"
        src="{{activeImageSrc}}"
        mode="aspectFill"
        class="product-image-img"
      />
      <view wx:else class="product-image-placeholder" style="color:{{categoryColor}}">📦</view>
    </view>

    <!-- Thumbnail strip -->
    <scroll-view wx:if="{{gallery.length > 1}}" class="thumb-scroll" scroll-x enable-flex>
      <view class="thumb-list">
        <view
          wx:for="{{gallery}}"
          wx:key="src"
          class="thumb {{activeImage === index ? 'thumb-active' : ''}}"
          data-idx="{{index}}"
          bindtap="onSelectImage"
        >
          <image src="{{item.resolved}}" mode="aspectFill" class="thumb-img" />
        </view>
      </view>
    </scroll-view>

    <view class="info-card card">
      <view class="product-name">{{product.name}}</view>

      <view wx:if="{{product.subtitle}}" class="muted subtitle">{{product.subtitle}}</view>

      <view class="meta-row">
        <view class="category-chip" style="background:{{categoryBg}}; color:{{categoryColor}}">{{product.category}}</view>
        <view wx:if="{{product.rating}}" class="muted">★ {{product.rating}} ({{product.reviewCount || reviewCountLabel}})</view>
        <view class="muted">库存 {{product.stock}}</view>
      </view>

      <view class="price-row">
        <text class="price-icon">🪙</text>
        <text class="price-value">{{pointsPriceFmt}}</text>
        <text class="price-unit muted">积分</text>
        <text wx:if="{{product.marketPrice}}" class="market-price muted">市场价 ¥{{product.marketPrice}}</text>
      </view>

      <view wx:if="{{product.promotion}}" class="promotion">{{product.promotion}}</view>

      <view wx:if="{{product.deliveryMethod}}" class="info-line">
        <text class="info-icon">🚚</text>
        <text>配送：{{product.deliveryMethod}}</text>
      </view>

      <view wx:if="{{product.serviceGuarantee}}" class="info-line">
        <text class="info-icon">🛡️</text>
        <text>保障：{{product.serviceGuarantee}}</text>
      </view>

      <!-- Color picker -->
      <view wx:if="{{colors.length > 0}}" class="picker-row">
        <view class="picker-label">颜色</view>
        <view class="picker-options">
          <view
            wx:for="{{colors}}"
            wx:for-item="color"
            wx:key="*this"
            class="color-option {{selectedColor === color ? 'color-option-active' : ''}}"
            data-color="{{color}}"
            bindtap="onSelectColor"
          >
            {{color}}
          </view>
        </view>
      </view>

      <!-- Quantity picker -->
      <view class="picker-row">
        <view class="picker-label">数量</view>
        <view class="qty-box">
          <view class="qty-btn {{quantity <= 1 ? 'qty-btn-disabled' : ''}}" bindtap="onQtyMinus">−</view>
          <view class="qty-value">{{quantity}}</view>
          <view class="qty-btn {{quantity >= product.stock ? 'qty-btn-disabled' : ''}}" bindtap="onQtyPlus">+</view>
        </view>
        <view class="muted picker-hint">有货（库存 {{product.stock}}）</view>
      </view>

      <view wx:if="{{product.description}}" class="section">
        <view class="section-title">商品描述</view>
        <view class="section-body">{{product.description}}</view>
      </view>
    </view>

    <!-- Related products -->
    <view wx:if="{{related.length > 0}}" class="card section-card">
      <view class="section-title">相关推荐</view>
      <view class="related-grid">
        <view
          wx:for="{{related}}"
          wx:key="id"
          class="related-card"
          data-id="{{item.id}}"
          bindtap="onRelatedTap"
        >
          <view class="related-image" style="background:{{item.categoryBg}}">
            <image
              wx:if="{{item.imageUrlResolved}}"
              src="{{item.imageUrlResolved}}"
              mode="aspectFill"
              class="related-image-img"
            />
            <view wx:else class="related-image-placeholder" style="color:{{item.categoryColor}}">📦</view>
          </view>
          <view class="related-name">{{item.name}}</view>
          <view class="related-price">🪙 {{item.pointsPriceFmt}}</view>
        </view>
      </view>
    </view>

    <!-- Reviews -->
    <view class="card section-card">
      <view class="section-title">商品评价 ({{reviewCountLabel}})</view>

      <view wx:if="{{user}}" class="review-form">
        <view class="rating-row">
          <text class="muted">您的评分</text>
          <view class="stars">
            <view
              wx:for="{{[1,2,3,4,5]}}"
              wx:for-item="value"
              wx:key="*this"
              class="star {{value <= myRating ? 'star-active' : ''}}"
              data-value="{{value}}"
              bindtap="onRatingTap"
            >★</view>
          </view>
        </view>
        <textarea
          class="review-input"
          placeholder="分享您的使用体验..."
          placeholder-class="placeholder"
          value="{{myReview}}"
          bindinput="onReviewInput"
          maxlength="500"
        />
        <view
          class="btn-primary review-submit {{(!myReview || submittingReview) ? 'btn-disabled' : ''}}"
          bindtap="onSubmitReview"
        >
          <view wx:if="{{submittingReview}}" class="spinner spinner-light"></view>
          <text wx:else>提交评价</text>
        </view>
      </view>

      <view wx:if="{{reviews.length === 0}}" class="muted no-reviews">暂无评价</view>
      <view wx:else class="review-list">
        <view wx:for="{{reviews}}" wx:key="id" class="review-item">
          <view class="review-head">
            <text class="review-stars">{{item.ratingStars}}</text>
            <text class="muted small">{{item.createdAtFmt}}</text>
          </view>
          <view class="review-body">{{item.content}}</view>
        </view>
      </view>
    </view>

    <view class="footer">
      <view class="btn-outline back-btn" bindtap="onBack">返回</view>
      <view
        class="btn-outline wish-btn {{wished ? 'wish-btn-active' : ''}}"
        bindtap="onToggleWish"
      >
        {{wished ? '♥ 已收藏' : '♡ 收藏'}}
      </view>
      <view
        class="btn-primary action-btn {{unavailable ? 'btn-disabled' : ''}}"
        bindtap="onRedeem"
      >
        {{actionLabel}}
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty-icon">📦</view>
    <view>商品不存在</view>
  </view>
</view>
