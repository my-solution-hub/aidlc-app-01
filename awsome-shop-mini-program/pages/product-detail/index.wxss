.page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 160rpx;
}

.product-image {
  width: 100%;
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-image-img {
  width: 100%;
  height: 100%;
}

.product-image-placeholder {
  font-size: 160rpx;
  opacity: 0.5;
}

.info-card {
  margin: 0 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-chip {
  display: inline-block;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-icon {
  font-size: 36rpx;
}

.price-value {
  color: var(--warning);
  font-size: 56rpx;
  font-weight: 700;
}

.price-unit {
  font-size: 26rpx;
}

.subtitle {
  font-size: 26rpx;
  line-height: 1.6;
}

.section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-top: 2rpx solid var(--border-soft);
  padding-top: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-body {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.section-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding-top: 8rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  border-top: 2rpx solid var(--border-soft);
  display: flex;
  gap: 16rpx;
  z-index: 10;
}

.back-btn {
  flex: 0 0 200rpx;
}

.action-btn {
  flex: 1;
}

.btn-disabled {
  background: #CBD5E1;
}
