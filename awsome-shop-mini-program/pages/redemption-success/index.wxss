.page {
  padding: 48rpx 24rpx;
}

.success-card {
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--success-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-top: 8rpx;
}

.divider {
  width: 100%;
  height: 2rpx;
  background: var(--border-soft);
}

.info-block {
  width: 100%;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
}

.info-value {
  font-weight: 600;
  color: var(--text-primary);
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}

.cost-value {
  color: var(--warning);
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.actions .btn-primary,
.actions .btn-outline {
  width: 100%;
}
