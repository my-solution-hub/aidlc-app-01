.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 96rpx;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #2563EB 0%, #60A5FA 100%);
  padding: 36rpx 40rpx;
  color: #fff;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin: 8rpx 0 16rpx;
}

.hero-cta {
  display: inline-block;
  align-self: flex-start;
  background: #fff;
  color: var(--primary);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.hero-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.hero-points-chip {
  background: rgba(255, 255, 255, 0.22);
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.hero-icon {
  font-size: 80rpx;
  opacity: 0.4;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid var(--border);
  padding: 0 20rpx;
  height: 80rpx;
}

.search-icon {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-btn {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
}

.placeholder {
  color: var(--text-disabled);
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: flex;
  gap: 12rpx;
  padding: 4rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.product-card {
  background: #fff;
  border-radius: 24rpx;
  border: 2rpx solid var(--border-soft);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.product-image {
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.product-image-img {
  width: 100%;
  height: 100%;
}

.product-image-placeholder {
  font-size: 80rpx;
  opacity: 0.6;
}

.product-body {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-category {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.product-sold {
  font-size: 20rpx;
  color: var(--text-disabled);
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.product-price {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.price-icon {
  font-size: 26rpx;
}

.price-value {
  color: var(--warning);
  font-size: 30rpx;
  font-weight: 700;
}

.product-redeem {
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 10rpx 24rpx;
}

.product-redeem-disabled {
  background: #CBD5E1;
}

.end-hint {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
}
