# ============================================================
# AWSomeShop — Docker Compose environment
# Copy to .env and adjust as needed:  cp .env.example .env
# Variable names match each service's application-docker.yml exactly.
# ============================================================

# ---- MySQL ----
# Services connect as root by default (DB_USERNAME default is "root").
# Root also has the DDL privileges Flyway needs to create tables.
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Shared DB connection (per-service DB_NAME is set in docker-compose.yml)
DB_USERNAME=root
DB_PASSWORD=root

# ---- Redis ----
REDIS_PORT=6379

# ---- JWT / crypto (shared across services) ----
# JWT_SECRET must be >= 256 bits (32+ chars) for HMAC-SHA256.
JWT_SECRET=docker-secret-key-for-jwt-token-must-be-at-least-256-bits-long-for-hmac-sha256
JWT_EXPIRATION=7200
# AES-256 encryption key (exactly 32 bytes)
ENCRYPTION_KEY=dockerEncryptionKey1234567890ab

# ---- Exposed host ports ----
GATEWAY_PORT=8080
FRONTEND_PORT=3000
